PORT=5000

# PostgreSQL connection string (must have pgvector extension installed)
# Example: postgresql://postgres:postgres@localhost:5432/codebase_intelligence
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codebase_intelligence

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
